<!DOCTYPE html>
<html lang="en">
<head>
  <title>User Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-5">
    <h1 class="mb-4 text-success">👥 User Verification Portal</h1>

    <!-- Verify Events Section -->
    <div class="card mb-4">
      <div class="card-header">Verify Events</div>
      <ul class="list-group list-group-flush">
        <% if (eventsToVerify && eventsToVerify.length > 0) { %>
          <% eventsToVerify.forEach(event => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= event.name %> | Date: <%= event.date %>
              <div>
                <form action="/user/verify/<%= event._id %>" method="POST" class="d-inline">
                  <input type="hidden" name="status" value="happened">
                  <button class="btn btn-outline-success btn-sm me-2">✅ Happened</button>
                </form>
                <form action="/user/verify/<%= event._id %>" method="POST" class="d-inline">
                  <input type="hidden" name="status" value="not_happened">
                  <button class="btn btn-outline-danger btn-sm">❌ Didn’t Happen</button>
                </form>
              </div>
            </li>
          <% }); %>
        <% } else { %>
          <li class="list-group-item">No events to verify</li>
        <% } %>
      </ul>
    </div>

    <!-- Voting History Section -->
    <div class="card mb-4">
      <div class="card-header">Voting History</div>
      <ul class="list-group list-group-flush">
        <% if (votingHistory && votingHistory.length > 0) { %>
          <% votingHistory.forEach(vote => { %>
            <li class="list-group-item">
              <%= vote.eventName %> - You voted: 
              <%= vote.status === 'happened' ? '✅ Happened' : '❌ Didn’t Happen' %>
            </li>
          <% }); %>
        <% } else { %>
          <li class="list-group-item">No voting history</li>
        <% } %>
      </ul>
    </div>

    <!-- User Profile Section -->
    <div class="card">
      <div class="card-header">Your Profile</div>
      <div class="card-body">
        <p>Name: <%= user.name %></p>
        <!-- Optional KYC -->
        <!-- <% if (user.kycVerified) { %>
          <p>KYC Verified: ✅</p>
        <% } else { %>
          <p>KYC Verified: ❌</p>
        <% } %> -->
      </div>
    </div>
  </div>
</body>
</html>
