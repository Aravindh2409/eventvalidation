<!DOCTYPE html>
<html lang="en">
<head>
  <title>Head Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-5">
    <h1 class="mb-4 text-primary">🚀 Head / Superior Dashboard</h1>

    <!-- Announce New Fund -->
    <div class="card mb-4">
      <div class="card-header">Announce New Fund</div>
      <div class="card-body">
        <form method="POST" action="/head/announce">
          <input type="text" class="form-control mb-2" name="department" placeholder="Department Name" required>
          <input type="number" class="form-control mb-2" name="amount" placeholder="Fund Amount" required>
          <textarea class="form-control mb-2" name="purpose" placeholder="Purpose of Fund"></textarea>
          <button type="submit" class="btn btn-success">Announce Fund</button>
        </form>
      </div>
    </div>

    <!-- Pending Fund Requests -->
    <div class="card mb-4">
      <div class="card-header">Pending Fund Requests</div>
      <ul class="list-group list-group-flush">
        <!-- Example of looping through pending requests -->
        <% if (pendingRequests && pendingRequests.length > 0) { %>
          <% pendingRequests.forEach(request => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              Dept: <%= request.department %> | ₹<%= request.amount %> | Reason: <%= request.reason %>
              <div>
                <form action="/head/approve/<%= request._id %>" method="POST" class="d-inline">
                  <button class="btn btn-success btn-sm me-2">Approve</button>
                </form>
                <form action="/head/reject/<%= request._id %>" method="POST" class="d-inline">
                  <button class="btn btn-danger btn-sm">Reject</button>
                </form>
              </div>
            </li>
          <% }) %>
        <% } else { %>
          <li class="list-group-item">No pending requests</li>
        <% } %>
      </ul>
    </div>

    <!-- Analytics Overview -->
    <div class="card">
      <div class="card-header">Analytics Overview</div>
      <div class="card-body">
        <p>Funds Released: ₹<%= analytics.released %></p>
        <p>Flagged Departments: <%= analytics.flagged %></p>
      </div>
    </div>
  </div>
</body>
</html>
