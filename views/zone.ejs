<!DOCTYPE html>
<html lang="en">
<head>
  <title>Zonal Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.2.0/ethers.umd.min.js"></script>
</head>
<body class="bg-light">
  <div class="container mt-5">
    <h1 class="mb-4 text-info">🏢 Zonal Head Dashboard</h1>

    <!-- Request Funds Section -->
    <div class="card mb-4">
		<button id="connectWalletBtn" class="btn btn-primary">🔗 Connect Wallet</button>
<span id="walletAddress" class="ms-2 fw-bold"></span>
<script>
	// Attach the event listener after DOM is loaded
	window.addEventListener('DOMContentLoaded', () => {
	  const connectBtn = document.getElementById('connectWalletBtn');
	  if (connectBtn) {
		connectBtn.addEventListener('click', connectWallet);
	  }
	});
  </script>
  
      <div class="card-header">Request Funds</div>
      <div class="card-body">
        <form id="fundRequestForm" onsubmit="submitFundRequest(event)">
			<textarea id="eventPlan" class="form-control mb-2" placeholder="Planned Events + Budget" required></textarea>
			<input id="budget" type="number" class="form-control mb-2" placeholder="Total Budget Required" required>
			<button type="submit" class="btn btn-primary">Request Fund</button>
		  </form>
		  
      </div>
    </div>

    <!-- Approved Fund Details Section -->
    <div class="card mb-4">
      <div class="card-header">Approved Fund Details</div>
      <ul class="list-group list-group-flush">
        <% if (approvedFunds && approvedFunds.length > 0) { %>
          <% approvedFunds.forEach(fund => { %>
            <li class="list-group-item">
              <%= fund.eventName %> | Approved: ₹<%= fund.amount %> | Deadline: <%= fund.deadline %>
            </li>
          <% }); %>
        <% } else { %>
          <li class="list-group-item">No funds approved yet.</li>
        <% } %>
      </ul>
    </div>

    <!-- Report Conducted Events Section -->
    <div class="card">
      <div class="card-header">Report Conducted Events</div>
      <div class="card-body">
        <form action="/zonal/report" method="POST" enctype="multipart/form-data">
          <input name="eventName" type="text" class="form-control mb-2" placeholder="Event Name" required>
          <input name="amountSpent" type="number" class="form-control mb-2" placeholder="Amount Spent" required>
          <input name="proofFiles" type="file" class="form-control mb-2" multiple>
          <button type="submit" class="btn btn-warning">Report</button>
        </form>
      </div>
    </div>

<!-- Fund Announcements (Hidden by Default) -->
<div id="fundAnnouncementsCard" class="card mt-4 mb-5 d-none">
  <h3>Previous Announcements </h3>
  <ul class="list-group list-group-flush" id="announcementList">
    <!-- Dynamic announcements will be injected here -->
  </ul>
</div>
<h3 class="mt-4">Previous Fund Requests</h3>
<div id="requestsList" class="mt-2 d-none"></div> <!-- Add d-none class here to hide it initially -->
<button onclick="loadAllRequests()" class="btn btn-secondary mb-2 d-none" id="refreshBtn">🔄 Refresh Fund Requests</button> <!-- Hide the refresh button as well -->


  </div>
  <script src="/js/contractConfig.js"></script>
  
  <script>
	
	let provider, signer, fundContract, zonalContract;
async function connectWallet() {
    if (window.ethereum) {
      try {
        const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
        const account = accounts[0];

        // Show wallet address
        document.getElementById('walletAddress').textContent = `${account.slice(0, 6)}...${account.slice(-4)}`;
		document.getElementById('connectWalletBtn').disabled = true;
        // Initialize provider, signer, contract
        provider = new ethers.providers.Web3Provider(window.ethereum);
        signer = provider.getSigner();
        fundContract = new ethers.Contract(fundAnnouncementsAddress, fundAnnouncementsABI, signer);
      zonalContract = new ethers.Contract(zonalFundRequestsAddress, zonalFundRequestsABI, signer);

        // Show announcements section
        const announcementsCard = document.getElementById('fundAnnouncementsCard');
        if (announcementsCard) {
          announcementsCard.classList.remove('d-none');
        }

        // Load announcements
        loadAnnouncements();

      } catch (err) {
        console.error("Wallet connection rejected:", err);
      }
    } else {
      alert("MetaMask not found! Please install MetaMask.");
    }
  }

    async function loadAnnouncements() {
      if (typeof window.ethereum !== 'undefined') {
        const provider = new ethers.providers.Web3Provider(window.ethereum);
        const signer = provider.getSigner();
        const contract = new ethers.Contract(fundAnnouncementsAddress, fundAnnouncementsABI, signer);
  
        try {
          const announcements = await fundContract.getAnnouncements();
          displayAnnouncements(announcements);
        } catch (error) {
          console.error("Error fetching announcements:", error);
        }
      } else {
        alert("MetaMask not found!");
      }
	  const requestsListDiv = document.getElementById('requestsList');
      if (requestsListDiv) {
        requestsListDiv.classList.remove('d-none');
      }

      const refreshBtn = document.getElementById('refreshBtn');
      if (refreshBtn) {
        refreshBtn.classList.remove('d-none');
      }
    }
  
    function displayAnnouncements(announcements) {
      const list = document.getElementById("announcementList");
      list.innerHTML = '';
  
      announcements.forEach(a => {
        const date = new Date(a.timestamp * 1000).toLocaleString(); // readable time
        const item = document.createElement('li');
        item.className = 'list-group-item';
        item.innerHTML = `
      <div>
        <strong>🏢 ${a.department}</strong><br>
        💸 <strong>Amount:</strong> ₹${ethers.utils.formatEther(a.amount)} <br>
        📄 <strong>Purpose:</strong> ${a.purpose} <br>
        🕒 <strong>Time:</strong> ${date} <br>
        🔐 <strong>Announced By:</strong> <span style="font-size: 0.9em">${a.announcedBy}</span>
      </div>
    `;
        list.appendChild(item);
      });
    }
	async function submitFundRequest(event) {
  event.preventDefault(); // prevent form from submitting the traditional way

  const eventPlan = document.getElementById("eventPlan").value;
  const budget = document.getElementById("budget").value;

  try {
    const provider = new ethers.providers.Web3Provider(window.ethereum);
    await provider.send("eth_requestAccounts", []); // ask MetaMask to connect
    const signer = provider.getSigner();
    const contract = new ethers.Contract(zonalFundRequestsAddress, zonalFundRequestsABI, signer);

    const tx = await contract.requestFund("YourZone", eventPlan, ethers.utils.parseEther(budget));
    await tx.wait();

    alert("Fund request submitted to the blockchain successfully!");

loadAllRequests(); // refresh list
  } catch (error) {
    console.error("Transaction error:", error);
    alert("Failed to submit fund request.");
  }
}
async function loadAllRequests() {
  try {
    const provider = new ethers.providers.Web3Provider(window.ethereum);
    const signer = provider.getSigner();
    const contract = new ethers.Contract(zonalFundRequestsAddress, zonalFundRequestsABI, signer);

    const requests = await contract.getAllRequests();

    const listDiv = document.getElementById("requestsList");
    listDiv.innerHTML = ""; // clear previous entries

    if (requests.length === 0) {
      listDiv.innerHTML = "<p>No fund requests yet.</p>";
      return;
    }

    requests.forEach(req => {
      const date = new Date(req.timestamp * 1000).toLocaleString();

      const requestHTML = `
        <div class="card mb-2 p-2">
        
          <strong>Event Name:</strong> ${req.eventPlan}<br>
          <strong>Budget:</strong> ₹${ethers.utils.formatEther(req.budget)}<br>
          <strong>Requester:</strong> ${req.requester}<br>

          <small><strong>Requested At:</strong> ${date}</small>
        </div>
      `;

      listDiv.innerHTML += requestHTML;
    });
	


  } catch (error) {
    console.error("Error loading requests:", error);
    document.getElementById("requestsList").innerText = "Failed to load requests.";
  }
}
window.onload = () => {
  loadAllRequests(); // show requests on page load
};

  </script>
  
  
</body>
</html>
